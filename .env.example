NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Razorpay's public key_id (not secret — safe client-side, same trust model as
# a Stripe publishable key). Must match the backend's RAZORPAY_KEY_ID env var
# (../salonjaa-backend/.env) since a mismatched key will fail order
# verification. Get it from https://dashboard.razorpay.com/app/keys — use the
# same Test Mode key as the backend for local dev. Payment (Module 6) fails
# to load the checkout widget without this set.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
